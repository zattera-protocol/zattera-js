{
  "name": "zattera-js",
  "version": "0.1.0",
  "description": "TypeScript library for Zattera blockchain RPC calls",
  "type": "module",
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser/index.js",
      "node": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "types": "./dist/types/index.d.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run build:node && npm run build:browser && npm run build:types",
    "build:node": "vite build --config vite.config.node.ts",
    "build:browser": "vite build --config vite.config.browser.ts",
    "build:types": "tsc --project tsconfig.types.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "zattera",
    "blockchain",
    "rpc",
    "web3",
    "typescript",
    "esm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/node": "^22.10.5",
    "@vitest/ui": "^2.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@noble/secp256k1": "^2.1.0",
    "bs58": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
